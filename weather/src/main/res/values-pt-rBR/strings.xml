    <string name="setting_units_title">Usar unidades métricas</string>
    <string name="setting_burn_in_title">Reduzir burn-in da tela</string>
    <string name="setting_burn_in_desc">Desloca o painel e o relógio alguns pixels de vez em quando. Ativado por padrão \u2014 ajuda em telas OLED e plasma e é imperceptível nas demais.</string>
    
    <string name="setting_nowcast_title">Previsão de chuva e neve iminentes</string>
    <string name="setting_nowcast_desc">Exibe \"começando em 25 min\" quando a precipitação está próxima</string>
    
    <string name="setting_advisories_title">Avisos úteis</string>
    <string name="setting_advisories_desc">Mensagens como \"possibilidade de geada esta noite\", \"tempo seco até 16h\" ou \"bom dia para secar roupa\"</string>
    <string name="setting_yesterday_title">Comparar com ontem</string>
    <string name="setting_yesterday_desc">Mostra quanto hoje está mais quente ou frio</string>
    <string name="setting_air_title">Qualidade do ar e pólen</string>
    <string name="setting_air_desc">Adiciona o AQI à linha de estatísticas e um aviso quando a qualidade do ar estiver ruim. Pólen quando disponível.</string>
    <string name="setting_marine_title">Condições marítimas</string>
    <string name="setting_marine_desc">Altura e período das ondas, quando houver uma grande massa de água por perto \u2014 oceano ou um dos Grandes Lagos</string>
    <string name="setting_last_updated_title">Exibir horário da última atualização</string>
    <string name="setting_last_updated_desc">Uma linha pequena \"Atualizado H:MM\" que mostra quando a imagem na tela foi renderizada, no horário local</string>
    <string name="setting_aurora_title">Monitoramento de aurora</string>
    <string name="setting_aurora_desc">Exibe uma linha quando o índice K torna a aurora possível na sua latitude</string>
    <string name="setting_safe_radar_title">Radar acessível para daltônicos</string>
    <string name="setting_safe_radar_desc">Muda as cores do radar para diferenciar chuva forte de chuva fraca</string>

    <string name="setting_alerts_title">Alertas de tempo severo</string>
    <string name="setting_alerts_desc">Faixa com alertas ativos do NWS (somente EUA)</string>
    <string name="setting_experimental_title">Recursos experimentais</string>
    <string name="setting_experimental_desc">Mostra opções de animação. Elas criam um vídeo curto, o que pode impedir o início da proteção de tela enquanto estiver ativo \u2014 isso foi confirmado em pelo menos um dispositivo. Se algo falhar, tudo volta a um papel de parede estático.</string>
    
    <string name="setting_precip_title">Animar chuva e neve</string>
    <string name="setting_precip_desc">Exibe chuva ou neve caindo sobre o plano de fundo quando houver precipitação. Cria um vídeo curto \u2014 pode impedir o início da proteção de tela.</string>
    <string name="setting_animate_title">Animar radar</string>
    <string name="setting_animate_wind_title">Animar vento</string>
    <string name="setting_animate_wind_desc">Move os traços ao longo do fluxo no plano de fundo do mapa de vento. Cria um vídeo curto, que leva alguns segundos para ficar pronto \u2014 pode impedir o início da proteção de tela.</string>
    <string name="setting_wind_precip_title">Chuva e neve no mapa de vento</string>
    <string name="setting_wind_precip_desc">Sobrepõe o radar mais recente aos traços de vento. Imagem estática, sem vídeo. Aplicável ao plano de fundo do mapa de vento.</string>
    <string name="setting_animate_desc">Repete as últimas duas horas de precipitação sobre o radar ao vivo ou o mapa de vento. Cria um vídeo curto, que leva alguns segundos para ficar pronto \u2014 pode impedir o início da proteção de tela.</string>
    <string name="toast_animate_needs_radar">Defina o plano de fundo como Radar ao vivo ou Mapa de vento para ver isso</string>
    <string name="toast_needs_wind_background">Defina o plano de fundo como Mapa de vento para ver isso</string>
    
