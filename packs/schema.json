{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Projectivy Weather Wallpaper pack index",
  "type": "object",
  "required": ["schemaVersion", "packs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "author", "license", "kind", "assets"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,39}$"
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "author": { "type": "string", "minLength": 1, "maxLength": 40 },
          "license": {
            "type": "string",
            "enum": ["CC0-1.0", "CC-BY-4.0", "CC-BY-SA-4.0", "Apache-2.0", "MIT"]
          },
          "kind": { "enum": ["static", "lottie", "video"] },
          "assets": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "enum": [
                "clear-day", "clear-night", "clear",
                "cloud-day", "cloud-night", "cloud",
                "rain-day", "rain-night", "rain",
                "snow-day", "snow-night", "snow",
                "storm-day", "storm-night", "storm",
                "day", "night", "default"
              ]
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        }
      }
    }
  }
}
